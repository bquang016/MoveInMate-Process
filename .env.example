# MoveInMate Team Progress Tracker — Environment Configuration
# Copy this file to .env and fill in your Supabase project credentials.
# Leave values empty to run in interactive Demo Mode (local synthetic dataset).

# Primary Vite / Browser Supabase variables
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional compatibility aliases (supported automatically)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Workspace & App metadata
VITE_DEFAULT_WORKSPACE_SLUG=moveinmate-vhr16
VITE_APP_NAME=MoveInMate AI Team Progress Tracker

# Optional Discord Webhook URL for real-time team notifications
VITE_DISCORD_WEBHOOK_URL=
